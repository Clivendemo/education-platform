# Environment configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database configuration (Prompt 03)
# In production, sslmode is required (e.g. ?sslmode=require, ?sslmode=verify-ca, or ?sslmode=verify-full)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/education_platform
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Test database isolation (Prompt 04)
# Used for isolated integration test suites and seed testing; must never point to production
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/education_platform_test

# Cloudflare R2 Object Storage (Prompt 09)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kenya-education-platform-files
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
MAX_FILE_SIZE_BYTES=52428800

# Canonical Domain (Prompt 12 - SEO / OpenGraph)
# Base domain used for canonical URL and OpenGraph metadata generation (trailing slashes stripped)
CANONICAL_DOMAIN=http://localhost:3000

# Platform Brand / Site Name (Prompt 12 - SEO / OpenGraph)
# Authoritative site name for OpenGraph og:site_name and brand metadata
SITE_NAME=ElimuPin

# Authentication Session Cookie (Prompt 13)
# Name of the HttpOnly session cookie used across API requests
SESSION_COOKIE_NAME=session_token

# M-Pesa / Daraja Configuration (Prompt 19)
# Environment: sandbox | production
MPESA_ENABLED=false
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-domain.example.com/api/v1/payments/mpesa/callback
