# Environment configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database configuration (Prompt 03)
# In production, sslmode is required (e.g. ?sslmode=require, ?sslmode=verify-ca, or ?sslmode=verify-full)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/education_platform
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Test database isolation (Prompt 04)
# Used for isolated integration test suites and seed testing; must never point to production
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/education_platform_test

# Cloudflare R2 Object Storage (Prompt 09)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kenya-education-platform-files
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
MAX_FILE_SIZE_BYTES=52428800
