# ElimuPin Frontend (/web) Environment Configuration
# Copy to .env.local for local development. Never place secrets in NEXT_PUBLIC_* variables.

# Public browser-safe configuration
NEXT_PUBLIC_APP_NAME=ElimuPin
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=KE
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# Server-only internal Fastify upstream origin (never exposed to browser bundles)
FASTIFY_INTERNAL_URL=http://127.0.0.1:3000
