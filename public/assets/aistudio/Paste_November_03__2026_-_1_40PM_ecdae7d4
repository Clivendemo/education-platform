5.2 Complete Atomic PostgreSQL Implementation (Migration 0024)
Classification: Complete SQL specification validated against PostgreSQL READ COMMITTED MVCC & node-postgres.
To eliminate multi-roundtrip pool hold time (1 pool.query call instead of 4), prevent cold-start INSERT races under READ COMMITTED, prevent cross-key deadlocks on multi-dimensional checks, prevent BIGINT multiplication overflow, and avoid PostgreSQL NUMERIC::bigint half-to-even rounding, Migration 0024 defines system.rate_limit_buckets and the VOLATILE PL/pgSQL function system.consume_rate_limit_buckets:
code
SQL
-- drizzle/0024_wave3_rate_limits.sql
CREATE TABLE IF NOT EXISTS "system"."rate_limit_buckets" (
  "id" UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  "bucket_key" VARCHAR(160) NOT NULL,
  "policy_id" VARCHAR(64) NOT NULL,
  "millitokens" BIGINT NOT NULL,
  "updated_at" TIMESTAMPTZ NOT NULL,
  "expires_at" TIMESTAMPTZ NOT NULL,
  CONSTRAINT "uq_rate_limit_buckets_bucket_key" UNIQUE ("bucket_key"),
  CONSTRAINT "chk_rlb_bucket_key_bounds" CHECK (
    length(btrim("bucket_key")) >= 16 AND length("bucket_key") <= 160
  ),
  CONSTRAINT "chk_rlb_policy_id_bounds" CHECK (
    length(btrim("policy_id")) >= 3 AND length("policy_id") <= 64
  ),
  CONSTRAINT "chk_rlb_millitokens_bounds" CHECK (
    "millitokens" >= 0 AND "millitokens" <= 1000000000
  ),
  CONSTRAINT "chk_rlb_expires_after_updated" CHECK (
    "expires_at" > "updated_at"
  )
);

CREATE INDEX IF NOT EXISTS "idx_rate_limit_buckets_expires_at"
  ON "system"."rate_limit_buckets" ("expires_at");

CREATE OR REPLACE FUNCTION "system"."consume_rate_limit_buckets"(
  p_bucket_keys TEXT[],
  p_policy_ids TEXT[],
  p_capacities_mt BIGINT[],
  p_refill_tokens_mt BIGINT[],
  p_refill_periods_ms BIGINT[],
  p_costs_mt BIGINT[],
  p_min_ttl_secs INTEGER[]
)
RETURNS TABLE (
  allowed BOOLEAN,
  limiting_policy_id TEXT,
  retry_after_ms BIGINT,
  min_remaining_mt BIGINT
)
LANGUAGE plpgsql
VOLATILE
AS $$
DECLARE
  v_count INTEGER;
  v_lock_hash INTEGER;
  v_now TIMESTAMPTZ;
  v_all_allowed BOOLEAN;
  v_limiting_policy TEXT;
  v_max_retry_ms BIGINT;
  v_min_remaining_mt BIGINT;
BEGIN
  v_count := COALESCE(array_length(p_bucket_keys, 1), 0);
  IF v_count < 1 OR v_count > 8
     OR array_length(p_policy_ids, 1) IS DISTINCT FROM v_count
     OR array_length(p_capacities_mt, 1) IS DISTINCT FROM v_count
     OR array_length(p_refill_tokens_mt, 1) IS DISTINCT FROM v_count
     OR array_length(p_refill_periods_ms, 1) IS DISTINCT FROM v_count
     OR array_length(p_costs_mt, 1) IS DISTINCT FROM v_count
     OR array_length(p_min_ttl_secs, 1) IS DISTINCT FROM v_count
  THEN
    RAISE EXCEPTION 'Invalid rate-limit bucket array dimensions (count=%)', v_count
      USING ERRCODE = '22023';
  END IF;

  -- 1. Deadlock-free transaction-scoped advisory locks in deterministic hash order.
  -- Serializes both cold-start first inserts and hot-row updates across instances.
  FOR v_lock_hash IN
    SELECT DISTINCT hashtext(k) AS h
    FROM unnest(p_bucket_keys) AS k
    ORDER BY h ASC
  LOOP
    PERFORM pg_advisory_xact_lock(839201, v_lock_hash);
  END LOOP;

  -- 2. Single authoritative database clock timestamp for all dimensions.
  v_now := clock_timestamp();

  -- 3. Evaluate all dimensions without mutating state unless ALL dimensions pass.
  WITH dims AS (
    SELECT
      ord::int AS idx,
      p_bucket_keys[ord] AS bucket_key,
      p_policy_ids[ord] AS policy_id,
      p_capacities_mt[ord] AS capacity_mt,
      p_refill_tokens_mt[ord] AS refill_tokens_mt,
      p_refill_periods_ms[ord] AS refill_period_ms,
      p_costs_mt[ord] AS cost_mt,
      p_min_ttl_secs[ord] AS min_ttl_sec
    FROM generate_subscripts(p_bucket_keys, 1) AS ord
  ),
  computed AS (
    SELECT
      d.idx,
      d.bucket_key,
      d.policy_id,
      d.capacity_mt,
      d.refill_tokens_mt,
      d.refill_period_ms,
      d.cost_mt,
      GREATEST(
        d.min_ttl_sec::bigint,
        CEIL((d.capacity_mt::numeric * d.refill_period_ms::numeric) / (d.refill_tokens_mt::numeric * 1000.0))::bigint + 60
      ) AS effective_ttl_sec,
      CASE
        WHEN r.id IS NULL OR r.expires_at <= v_now THEN d.capacity_mt
        ELSE LEAST(
          d.capacity_mt,
          r.millitokens + FLOOR(
            (GREATEST(0::numeric, EXTRACT(EPOCH FROM (v_now - r.updated_at)) * 1000.0) * d.refill_tokens_mt::numeric)
            / d.refill_period_ms::numeric
          )::bigint
        )
      END AS refilled_mt,
      CASE
        WHEN r.id IS NULL OR r.expires_at <= v_now THEN v_now
        WHEN r.millitokens + FLOOR(
          (GREATEST(0::numeric, EXTRACT(EPOCH FROM (v_now - r.updated_at)) * 1000.0) * d.refill_tokens_mt::numeric)
          / d.refill_period_ms::numeric
        )::bigint >= d.capacity_mt THEN v_now
        ELSE LEAST(
          v_now,
          r.updated_at + (
            CEIL(
              (
                FLOOR(
                  (GREATEST(0::numeric, EXTRACT(EPOCH FROM (v_now - r.updated_at)) * 1000.0) * d.refill_tokens_mt::numeric)
                  / d.refill_period_ms::numeric
                ) * d.refill_period_ms::numeric
              ) / d.refill_tokens_mt::numeric
            )::bigint * INTERVAL '1 millisecond'
          )
        )
      END AS next_updated_at
    FROM dims d
    LEFT JOIN "system"."rate_limit_buckets" r
      ON r."bucket_key" = d.bucket_key
  ),
  verdict AS (
    SELECT
      bool_and(c.refilled_mt >= c.cost_mt) AS all_ok,
      (
        SELECT c2.policy_id
        FROM computed c2
        WHERE c2.refilled_mt < c2.cost_mt
        ORDER BY CEIL(((c2.cost_mt - c2.refilled_mt)::numeric * c2.refill_period_ms::numeric) / c2.refill_tokens_mt::numeric)::bigint DESC,
                 c2.idx ASC
        LIMIT 1
      ) AS lim_policy,
      COALESCE(
        MAX(
          GREATEST(
            1::bigint,
            CEIL(((c.cost_mt - c.refilled_mt)::numeric * c.refill_period_ms::numeric) / c.refill_tokens_mt::numeric)::bigint
          )
        ) FILTER (WHERE c.refilled_mt < c.cost_mt),
        0::bigint
      ) AS retry_ms,
      COALESCE(MIN(c.refilled_mt - c.cost_mt), 0::bigint) AS min_rem_mt
    FROM computed c
  ),
  applied AS (
    INSERT INTO "system"."rate_limit_buckets" (
      "bucket_key",
      "policy_id",
      "millitokens",
      "updated_at",
      "expires_at"
    )
    SELECT
      c.bucket_key,
      c.policy_id,
      c.refilled_mt - c.cost_mt,
      c.next_updated_at,
      v_now + make_interval(secs => c.effective_ttl_sec::double precision)
    FROM computed c
    CROSS JOIN verdict v
    WHERE v.all_ok = TRUE
    ON CONFLICT ("bucket_key") DO UPDATE SET
      "policy_id" = EXCLUDED."policy_id",
      "millitokens" = EXCLUDED."millitokens",
      "updated_at" = EXCLUDED."updated_at",
      "expires_at" = EXCLUDED."expires_at"
    RETURNING 1
  )
  SELECT v.all_ok, v.lim_policy, v.retry_ms, GREATEST(0::bigint, v.min_rem_mt)
  INTO v_all_allowed, v_limiting_policy, v_max_retry_ms, v_min_remaining_mt
  FROM verdict v;

  RETURN QUERY SELECT v_all_allowed, v_limiting_policy, v_max_retry_ms, v_min_remaining_mt;
END;
$$;
Verification of All 6 Required SQL Properties:
Single Database Clock: v_now := clock_timestamp() is captured once and reused across every expression in the statement.
Exact Integer millitokens Arithmetic: Uses FLOOR (never ::bigint rounding) for earned tokens and CEIL for consumed_ms, retry_ms, and effective_ttl_sec, over NUMERIC intermediates so elapsed_ms * refill_tokens_mt can never overflow int8.
Zero Negative Balances: WHERE v.all_ok = TRUE guarantees c.refilled_mt >= c.cost_mt, reinforced at the table layer by chk_rlb_millitokens_bounds (millitokens >= 0).
Zero Refill Progress Loss on Both Rejected and Accepted Requests: Rejected requests perform zero writes (updated_at, millitokens, and expires_at remain untouched). Even on accepted burst requests, next_updated_at advances only by the consumed_ms corresponding to whole millitokens credited, preserving sub-millitoken fractional elapsed time.
Deterministic Concurrent Cold-Start & Hot-Row Behavior: pg_advisory_xact_lock(839201, hashtext(k)) serializes concurrent callers even before a row exists, and inside a VOLATILE PL/pgSQL function under READ COMMITTED, the subsequent WITH statement acquires a fresh MVCC snapshot seeing all previously committed rows, then releases the transaction advisory lock automatically as soon as the single SELECT * FROM system.consume_rate_limit_buckets(...) call returns.
Accurate Retry-After Calculation: Returns exact millisecond deficit MAX(CEIL((cost_mt - refilled_mt) * refill_period_ms / refill_tokens_mt)) across all exhausted dimensions; middleware emits Retry-After: Math.max(1, Math.ceil(retry_after_ms / 1000)).
